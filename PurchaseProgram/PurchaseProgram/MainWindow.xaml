<Window x:Class="PurchaseProgram.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PurchaseProgram"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" ResizeMode="NoResize">
    <Grid Margin="10,10,10,10">
        <Button x:Name="Purchase" Content="Купить" HorizontalAlignment="Left" Margin="624,331,0,0" VerticalAlignment="Top" Height="56" Width="130" Click="Purchase_Click" BorderBrush="#FF060606">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF71FF73" Offset="1"/>
                    <GradientStop Color="#FF9BE29C"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Label x:Name="NameText" Content="Имя:" HorizontalAlignment="Left" Margin="22,21,0,0" VerticalAlignment="Top"/>
        <Label x:Name="BalanceText" Content="Баланс:" HorizontalAlignment="Left" Margin="22,66,0,0" VerticalAlignment="Top"/>
        <Label x:Name="Name" Content="Label" HorizontalAlignment="Left" Margin="58,21,0,0" VerticalAlignment="Top"/>
        <Label x:Name="Balance" Content="Label" HorizontalAlignment="Left" Margin="72,66,0,0" VerticalAlignment="Top"/>
        <Label Content="Количество билетов: " HorizontalAlignment="Left" Margin="14,351,0,0" VerticalAlignment="Top" Width="126"/>
        <Slider x:Name="Slider" HorizontalAlignment="Left" Margin="145,355,0,0" VerticalAlignment="Top" Width="120" ValueChanged="Slider_ValueChanged" SmallChange="0" TickPlacement="BottomRight" IsSnapToTickEnabled="True" Minimum="1"/>
        <Label x:Name="CountTicket" Content="1" HorizontalAlignment="Left" Margin="270,351,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>
